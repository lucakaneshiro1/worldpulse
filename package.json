{
  "name": "@local/worldpulse",
  "version": "1.1.0",
  "private": true,
  "description": "WorldPulse — live world news, situation analysis, and worldwide trip planning for DSH.",
  "license": "MIT",
  "author": "lucakaneshiro1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucakaneshiro1/worldpulse.git"
  },
  "homepage": "https://github.com/lucakaneshiro1/worldpulse#readme",
  "bugs": {
    "url": "https://github.com/lucakaneshiro1/worldpulse/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "worldpulse",
    "news",
    "travel"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
